<Window x:Class="HarnessPortable.Windows.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Harness Portable · 管理"
        Width="1020" Height="780"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <!-- The management UI is deliberately a window of its own: it must stay
         reachable when the workspace window is closed to the tray, and it must
         not be a dock tab that a pane bug can make unreachable. -->
    <ContentControl x:Name="Host"/>
</Window>
