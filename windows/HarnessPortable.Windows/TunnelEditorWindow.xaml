<Window x:Class="HarnessPortable.Windows.TunnelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 隧道" Icon="/Assets/HarnessPortable.ico" Height="620" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称（可选）" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Padding="6,5"/>

                <TextBlock Text="服务器地址" Margin="0,12,0,4"/>
                <TextBox x:Name="HostBox" Padding="6,5"/>

                <TextBlock Text="SSH 端口" Margin="0,12,0,4"/>
                <TextBox x:Name="SshPortBox" Padding="6,5" Text="22"/>

                <TextBlock Text="用户名" Margin="0,12,0,4"/>
                <TextBox x:Name="UserBox" Padding="6,5"/>

                <TextBlock x:Name="PasswordCaption" Text="密码（可稍后输入）" Margin="0,12,0,4"/>
                <PasswordBox x:Name="PasswordInput" Padding="6,5"/>

                <TextBlock Text="远程地址（服务器侧）" Margin="0,12,0,4"/>
                <TextBox x:Name="RemoteHostBox" Padding="6,5" Text="127.0.0.1"/>

                <TextBlock Text="远程端口" Margin="0,12,0,4"/>
                <TextBox x:Name="RemotePortBox" Padding="6,5" Text="3080"/>

                <TextBlock Text="本地端口" Margin="0,12,0,4"/>
                <TextBox x:Name="LocalPortBox" Padding="6,5" Text="3080"/>

                <TextBlock Margin="0,12,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                           Text="等价于 ssh -N -L 本地端口:远程地址:远程端口 用户名@服务器&#10;服务器可填 IP / 域名 / NetBIOS 名；Tailscale MagicDNS 也会被系统解析。&#10;密码使用 Windows DPAPI 加密存储，仅用于建立隧道。"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="保存" Width="88" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
