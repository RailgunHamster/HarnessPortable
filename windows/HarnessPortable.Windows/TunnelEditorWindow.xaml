<Window x:Class="HarnessPortable.Windows.TunnelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 隧道" Icon="/Assets/HarnessPortable.png" Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F9FAFB"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称（可选）" Margin="0,0,0,4" Style="{StaticResource ModernMutedText}"/>
                <TextBox x:Name="NameBox" Style="{StaticResource ModernTextBox}"/>

                <TextBlock Text="服务器地址" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="..." Padding="8,6" Margin="8,0,0,0"
                            Style="{StaticResource ModernToolbarButton}"
                            ToolTip="选择 SSH config 文件"
                            Click="ChooseSshConfig_Click"/>
                    <Button DockPanel.Dock="Right" Content="↻" Padding="9,6" Margin="8,0,0,0"
                            Style="{StaticResource ModernToolbarButton}"
                            ToolTip="刷新 SSH 配置"
                            Click="RefreshSshConfig_Click"/>
                    <ComboBox x:Name="HostBox"
                              Style="{StaticResource ModernEditableComboBox}"
                              ToolTip="输入 IP、机器名或域名；下拉可选择 SSH 配置别名"
                              DropDownOpened="HostBox_DropDownOpened"
                              SelectionChanged="HostBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#6B7280"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <TextBlock x:Name="SshConfigPathText" Margin="0,4,0,0" Foreground="#6B7280"
                           FontSize="11" TextTrimming="CharacterEllipsis" Text="SSH 配置：~/.ssh/config"/>

                <TextBlock Text="SSH 端口" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <TextBox x:Name="SshPortBox" Style="{StaticResource ModernTextBox}" Text="22"/>

                <TextBlock Text="用户名" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <TextBox x:Name="UserBox" Style="{StaticResource ModernTextBox}"/>

                <TextBlock x:Name="PasswordCaption" Text="密码（可稍后输入；密钥登录可留空）" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <PasswordBox x:Name="PasswordInput" Style="{StaticResource ModernPasswordBox}"/>

                <TextBlock Text="私钥文件（可选）" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="清除" Padding="8,6" Margin="8,0,0,0"
                            Style="{StaticResource ModernToolbarButton}"
                            ToolTip="清除私钥路径，改用 ~/.ssh 默认身份文件"
                            Click="ClearIdentityFile_Click"/>
                    <Button DockPanel.Dock="Right" Content="..." Padding="8,6" Margin="8,0,0,0"
                            Style="{StaticResource ModernToolbarButton}"
                            ToolTip="选择 SSH 私钥"
                            Click="ChooseIdentityFile_Click"/>
                    <TextBox x:Name="IdentityFileBox" Style="{StaticResource ModernTextBox}"
                             ToolTip="留空则尝试 ~/.ssh/id_ed25519、id_ecdsa、id_rsa"/>
                </DockPanel>

                <TextBlock Text="远程地址（服务器侧）" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <TextBox x:Name="RemoteHostBox" Style="{StaticResource ModernTextBox}" Text="127.0.0.1"/>

                <TextBlock Text="远程端口" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <TextBox x:Name="RemotePortBox" Style="{StaticResource ModernTextBox}" Text="3080"/>

                <TextBlock Text="本地端口" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <TextBox x:Name="LocalPortBox" Style="{StaticResource ModernTextBox}" Text="3080"/>

                <TextBlock Text="Web 登录方式" Margin="0,12,0,4" Style="{StaticResource ModernMutedText}"/>
                <ComboBox x:Name="AuthModeBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0"
                          SelectionChanged="AuthModeBox_SelectionChanged">
                    <ComboBoxItem Content="NSSM 自动获取（服务器用 NSSM 托管 dsh web）" Tag="nssm"/>
                    <ComboBoxItem Content="手动输入（连接时用下方填写的认证 URL/token）" Tag="manual"/>
                </ComboBox>

                <StackPanel x:Name="AuthInputPanel" Visibility="Collapsed">
                    <TextBlock x:Name="AuthInputCaption" Text="认证 URL 或 token（可选）" Margin="0,12,0,4"
                               Style="{StaticResource ModernMutedText}"/>
                    <TextBox x:Name="AuthInputBox" Style="{StaticResource ModernTextBox}"/>
                    <TextBlock Margin="0,4,0,0" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"
                               Text="粘贴服务器上 dsh web 打印的带 token 的 URL，或直接粘贴 token 本身；保存后连接时会直接用它登录，NSSM 抓取失败时也会回退到它。留空则连接后在页面上粘贴；编辑时清空即删除已保存的值。值用 Windows DPAPI 加密存储，不写入 profiles.json。"/>
                </StackPanel>

                <TextBlock Margin="0,12,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                           Text="等价于 ssh -N -L 本地端口:远程地址:远程端口 用户名@服务器&#10;打开服务器地址下拉可选择 ~/.ssh/config 中的 SSH 别名；选择后会填入 HostName、User、Port 和 IdentityFile，也可以继续手动修改。~ 会按当前运行用户解析；若程序以其他用户运行，可用右侧 ... 直接选择 config 文件。&#10;未填密码时使用指定私钥或 ~/.ssh 默认身份文件登录。密码错误只尝试一次，不会反复重连以免锁死账号。&#10;密码与认证 URL/token 使用 Windows DPAPI 加密存储，不写入 profiles.json。&#10;NSSM 方式：每次连接后自动在服务器上定位 NSSM 托管的 dsh web 日志，提取带 token 的 URL 并在内置浏览器中自动登录；手动方式：连接时用上面保存的认证 URL/token，留空则页面提示需要认证时粘贴 URL，登录后凭 cookie 自动保持约 30 天。"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" Style="{StaticResource ModernButton}" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="保存" Width="88" Style="{StaticResource ModernPrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
