<Window x:Class="HarnessPortable.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · Harness Portable" Width="760" Height="660" MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource DshBgBase}" FontFamily="{DynamicResource DshUiFont}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="24,20" Background="{DynamicResource DshBgLayer1}" BorderBrush="{DynamicResource DshBorderL1}" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="设置" Style="{StaticResource DshSectionHeader}"/>
                <TextBlock Text="本设备的偏好 · 网页、连接和分屏保持打开" Style="{StaticResource DshMuted}" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="18,12" BorderBrush="{DynamicResource DshBorderL1}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="SaveStatus" Text="偏好立即保存；地址修改需要明确保存。" Style="{StaticResource DshMuted}"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="Categories" Background="Transparent" BorderThickness="0" Margin="12,18,8,0"
                     Foreground="{DynamicResource DshTextPrimary}" SelectedIndex="0" SelectionChanged="Category_Changed">
                <ListBoxItem Content="通用" Padding="10,12"/>
                <ListBoxItem Content="工作区" Padding="10,12"/>
                <ListBoxItem Content="数据与安全" Padding="10,12"/>
                <ListBoxItem Content="更新与关于" Padding="10,12"/>
            </ListBox>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,22,24,24">
                <Grid>
                    <StackPanel x:Name="GeneralPage">
                        <TextBlock Text="通用" Style="{StaticResource DshSectionHeader}"/>
                        <TextBlock Text="外观" Style="{StaticResource DshLabel}" Margin="0,22,0,7"/>
                        <ComboBox x:Name="AppearanceBox" Style="{StaticResource ModernComboBox}" SelectionChanged="Preference_Changed">
                            <ComboBoxItem Content="跟随系统" Tag="system"/><ComboBoxItem Content="浅色" Tag="light"/><ComboBoxItem Content="深色" Tag="dark"/>
                        </ComboBox>
                        <TextBlock Text="关闭主窗口时" Style="{StaticResource DshLabel}" Margin="0,24,0,7"/>
                        <ComboBox x:Name="CloseBox" Style="{StaticResource ModernComboBox}" SelectionChanged="Preference_Changed">
                            <ComboBoxItem Content="退出并断开连接" Tag="exit"/><ComboBoxItem Content="收起到托盘，保持连接" Tag="tray"/>
                        </ComboBox>
                        <TextBlock Text="关闭网页标签只关闭此网页。服务器连接可以在连接库中单独断开。" Style="{StaticResource DshMuted}" Margin="0,20,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="WorkspacePage" Visibility="Collapsed">
                        <TextBlock Text="工作区" Style="{StaticResource DshSectionHeader}"/>
                        <CheckBox x:Name="RestoreBox" Content="启动时恢复上次工作区" Style="{StaticResource DshCheckBox}" Margin="0,24,0,8" Checked="Preference_Changed" Unchecked="Preference_Changed"/>
                        <TextBlock Text="自动记录标签、网页状态和分屏比例，不需要先保存预设。" Style="{StaticResource DshMuted}"/>
                        <CheckBox x:Name="ReconnectBox" Content="恢复工作区时自动连接服务器" Style="{StaticResource DshCheckBox}" Margin="0,24,0,8" Checked="Preference_Changed" Unchecked="Preference_Changed"/>
                        <TextBlock Text="关闭时仅恢复布局，点击连接后再建立 SSH 隧道。" Style="{StaticResource DshMuted}"/>
                        <Border Style="{StaticResource DshDivider}"/>
                        <TextBlock Text="工作区预设" Style="{StaticResource DshSectionHeader}"/>
                        <TextBlock Text="工具栏中的“保存预设”用于保存一套固定布局，与上次工作区的自动快照分别保留。" Style="{StaticResource DshMuted}" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="SecurityPage" Visibility="Collapsed">
                        <TextBlock Text="数据与安全" Style="{StaticResource DshSectionHeader}"/>
                        <TextBlock Text="连接凭据" Style="{StaticResource DshLabel}" Margin="0,24,0,8"/>
                        <TextBlock Text="在连接库的菜单中编辑对应连接。SSH 登录与网页登录分别配置，修改下次连接生效。密码、私钥和服务令牌不会写入工作区快照。" Style="{StaticResource DshMuted}"/>
                        <Button Content="返回连接库" Style="{StaticResource ModernToolbarButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ReturnToLibrary_Click"/>
                        <Border Style="{StaticResource DshDivider}"/>
                        <TextBlock Text="导出连接配置" Style="{StaticResource DshSectionHeader}"/>
                        <TextBlock Text="只导出服务器和端口等连接信息，不包含密码、私钥内容和登录令牌。" Style="{StaticResource DshMuted}" Margin="0,12,0,12"/>
                        <Button Content="导出配置…" Style="{StaticResource ModernToolbarButton}" HorizontalAlignment="Left" Click="Export_Click"/>
                    </StackPanel>
                    <StackPanel x:Name="UpdatesPage" Visibility="Collapsed">
                        <TextBlock Text="更新与关于" Style="{StaticResource DshSectionHeader}"/>
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource DshMono}" Margin="0,16,0,12"/>
                        <TextBlock x:Name="CurrentSourceLabel" Style="{StaticResource DshMuted}"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="CheckButton" Content="检查更新" Style="{StaticResource ModernPrimaryButton}" Click="Check_Click"/>
                            <Button x:Name="InstallButton" Content="下载并重启" Style="{StaticResource ModernToolbarButton}" Margin="8,0,0,0" Click="Install_Click" Visibility="Collapsed"/>
                        </WrapPanel>
                        <ProgressBar x:Name="Progress" Maximum="100" Height="5" Margin="0,14,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="UpdateStatusLabel" Style="{StaticResource DshMuted}" Margin="0,14,0,0"/>
                        <Expander Header="高级：局域网目录或自定义更新源" Foreground="{DynamicResource DshTextSecondary}" Margin="0,24,0,0">
                            <StackPanel Margin="0,12,0,0">
                                <ComboBox x:Name="SourceBox" Style="{StaticResource ModernComboBox}" SelectionChanged="Source_Changed">
                                    <ComboBoxItem Content="官方 / GitHub" Tag="github"/><ComboBoxItem Content="局域网目录 / HTTP" Tag="home"/>
                                </ComboBox>
                                <TextBox x:Name="SourceAddressBox" Style="{StaticResource ModernTextBox}" Margin="0,10,0,0" TextChanged="SourceAddress_Changed"/>
                                <TextBlock x:Name="DraftHint" Style="{StaticResource DshMuted}" Margin="0,8,0,0" Text="修改后需要保存"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="保存并使用" Style="{StaticResource ModernPrimaryButton}" Click="SaveSource_Click"/>
                                    <Button Content="撤销修改" Style="{StaticResource ModernToolbarButton}" Margin="8,0,0,0" Click="ResetSource_Click"/>
                                    <Button Content="官方源" Style="{StaticResource ModernToolbarButton}" Margin="8,0,0,0" Click="OfficialSource_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="版本说明" Foreground="{DynamicResource DshTextSecondary}" Margin="0,20,0,0">
                            <TextBlock x:Name="ReleaseNotes" Style="{StaticResource DshMuted}" Margin="0,12,0,0"/>
                        </Expander>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
