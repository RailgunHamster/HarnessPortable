<UserControl x:Class="HarnessPortable.Windows.Controls.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF"
             FontFamily="Segoe UI, Microsoft YaHei UI">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F9FAFB" Padding="16,12" BorderBrush="#EBEEF2" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="AddTunnelButton" DockPanel.Dock="Right" Content="+ 添加隧道"
                        Style="{StaticResource ModernPrimaryButton}" Padding="14,7"
                        Click="AddTunnel_Click"/>
                <Button x:Name="HeaderUpdateButton" DockPanel.Dock="Right" Content="检查更新"
                        Style="{StaticResource ModernButton}" Padding="14,7" Margin="0,0,8,0"
                        Click="HeaderUpdate_Click"/>
                <StackPanel>
                    <TextBlock Text="Harness Portable" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="SSH 本地端口转发 + 内嵌浏览器" Style="{StaticResource ModernMutedText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SSH 隧道" Style="{StaticResource ModernGroupHeader}"/>
                    <TextBlock x:Name="TunnelCountText" Grid.Column="1" Text="0"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#9CA3AF" FontSize="12"/>
                </Grid>

                <TextBlock x:Name="EmptyTunnelsHint" Style="{StaticResource ModernMutedText}" Margin="0,0,0,10"
                           Text="还没有隧道。点右上角 + 添加：填服务器 IP / 域名 / NetBIOS 名、SSH 端口、用户名，转发到 127.0.0.1:3080。"/>

                <ItemsControl x:Name="TunnelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium"
                                                       Foreground="#111827" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding StatusVisibility}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource ModernMutedText}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding LocalText}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ModernButton}" Content="连接"
                                                Tag="{Binding}" Click="TunnelConnect_Click"/>
                                        <Button Style="{StaticResource ModernButton}" Content="停止"
                                                Tag="{Binding}" Click="TunnelStop_Click"
                                                Visibility="{Binding StopVisibility}"/>
                                        <Button Style="{StaticResource ModernButton}" Content="编辑"
                                                Tag="{Binding}" Click="TunnelEdit_Click"/>
                                        <Button Style="{StaticResource ModernDangerButton}" Content="删除"
                                                Tag="{Binding}" Click="TunnelDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,12,0,12"/>

                <TextBlock Text="直连" Style="{StaticResource ModernGroupHeader}" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="添加" Padding="14,6" Margin="8,0,0,0"
                            Style="{StaticResource ModernPrimaryButton}"
                            Click="AddDirect_Click"/>
                    <Button DockPanel.Dock="Right" Content="↻" Padding="9,6" Margin="0,0,8,0"
                            Style="{StaticResource ModernToolbarButton}"
                            ToolTip="刷新局域网机器"
                            Click="RefreshDirectMachines_Click"/>
                    <ComboBox x:Name="DirectInput"
                              Style="{StaticResource ModernEditableComboBox}"
                              ToolTip="输入 IP、机器名或完整 URL；下拉可选择局域网机器"
                              DropDownOpened="DirectInput_DropDownOpened"
                              SelectionChanged="DirectInput_SelectionChanged"/>
                </DockPanel>
                <TextBlock x:Name="EmptyDirectHint" Style="{StaticResource ModernMutedText}" Margin="0,0,0,10"
                           Text="也可直接添加 http(s) 地址，不经过 SSH 隧道访问；打开输入框下拉可选择局域网机器。"/>
                <ItemsControl x:Name="DirectList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Host}" FontSize="14" FontWeight="Medium" Foreground="#111827"/>
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource ModernMutedText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ModernButton}" Content="连接"
                                                Tag="{Binding}" Click="DirectConnect_Click"/>
                                        <Button Style="{StaticResource ModernDangerButton}" Content="删除"
                                                Tag="{Binding}" Click="DirectDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,12,0,12"/>

                <TextBlock Text="设置" Style="{StaticResource ModernGroupHeader}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource ModernCardBorder}">
                    <StackPanel>
                        <TextBlock Text="关闭主窗口时" FontSize="13" Foreground="#111827"/>
                        <ComboBox x:Name="CloseBehaviorBox" Width="240" Margin="0,8,0,0"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="CloseBehaviorBox_SelectionChanged"/>
                        <CheckBox x:Name="RestoreLayoutBox" Margin="0,12,0,0" FontSize="13"
                                  Content="启动时自动恢复上次布局（不显示主界面）"
                                  Checked="RestoreLayoutBox_Changed"
                                  Unchecked="RestoreLayoutBox_Changed"/>

                        <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="#111827" Text="自动更新"/>
                        <TextBlock x:Name="VersionText" Margin="0,4,0,0" Style="{StaticResource ModernMutedText}"/>
                        <TextBlock Margin="0,8,0,4" Style="{StaticResource ModernMutedText}" Text="更新服务器（UNC 路径、http 目录或 GitHub 仓库）"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="保存" Padding="12,6" Margin="8,0,0,0"
                                    Style="{StaticResource ModernButton}" Click="SaveUpdateServer_Click"/>
                            <TextBox x:Name="UpdateServerBox" Style="{StaticResource ModernTextBox}"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="CheckUpdateButton" Content="检查更新" Padding="12,6"
                                    Style="{StaticResource ModernButton}" Click="CheckUpdate_Click"/>
                            <Button x:Name="ApplyUpdateButton" Content="下载并重启" Padding="12,6" Margin="8,0,0,0"
                                    Style="{StaticResource ModernPrimaryButton}" Click="ApplyUpdate_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusText" Margin="0,8,0,0" Style="{StaticResource ModernMutedText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Margin="0,12,0,4" Style="{StaticResource ModernMutedText}" Text="更新日志"/>
                        <TextBox x:Name="ChangelogBox" MinHeight="140" MaxHeight="240"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Margin="0,10,0,0" Style="{StaticResource ModernMutedText}"
                                   TextWrapping="Wrap"
                                   Text="安装包与便携 zip 都会自动更新。便携版请解压后运行根目录的 Harness Portable.exe。开发运行和旧版单文件 exe 不能在线更新。配置保存在 %APPDATA%\HarnessPortable，不会写入程序目录。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
