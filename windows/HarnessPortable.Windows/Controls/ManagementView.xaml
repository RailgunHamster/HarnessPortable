<UserControl x:Class="HarnessPortable.Windows.Controls.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DshBgBase}"
             FontFamily="{DynamicResource DshUiFont}">

    <!-- Everything here references the DSH token dictionary with DynamicResource
         (see Themes/DshTokens.*.xaml + Services/AppTheme.cs), so the page follows
         the Windows app-mode setting without a restart. -->

    <UserControl.Resources>
        <!-- Keep long lists and update notes consistent with the shell palette. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DshScrollBar}"/>

        <Style x:Key="DshRowButton" TargetType="Button" BasedOn="{StaticResource DshButton}">
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style x:Key="DshRowPrimaryButton" TargetType="Button" BasedOn="{StaticResource DshPrimaryButton}">
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource DshBgLayer1}"
                BorderBrush="{DynamicResource DshBorderL1}"
                BorderThickness="0,0,0,1"
                Padding="24,22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HeaderUpdateButton" Content="检查更新"
                            Style="{StaticResource DshButton}" Padding="14,7" Margin="0"
                            Click="HeaderUpdate_Click" AutomationProperties.AutomationId="ManagementView.HeaderUpdateButton"/>
                    <Button x:Name="AddTunnelButton" Content="＋ 添加隧道"
                            Style="{StaticResource DshPrimaryButton}" Padding="14,7"
                            Click="AddTunnel_Click" AutomationProperties.AutomationId="ManagementView.AddTunnelButton"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,14,0"
                            Background="{DynamicResource DshAccentSoft}">
                        <Viewbox Width="24" Height="24">
                            <Path Data="M2,7 L12,2 L22,7 L12,12 Z M2,12 L12,17 L22,12 M2,17 L12,22 L22,17"
                                  Stroke="{DynamicResource DshAccent}" StrokeThickness="2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Viewbox>
                    </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="连接中心" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource DshTextPrimary}"/>
                    <TextBlock Text="管理隧道与直连，快速进入工作区"
                               Style="{StaticResource DshMuted}" Margin="0,3,0,0"/>
                  </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="ManagementTabs" Style="{StaticResource DshTabs}" AutomationProperties.AutomationId="ManagementView.TabControl.1">
            <TabItem Header="SSH 隧道" AutomationProperties.AutomationId="ManagementView.TabItem.1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,22,24,28" AutomationProperties.AutomationId="ManagementView.ScrollViewer">
                    <StackPanel MaxWidth="940" HorizontalAlignment="Stretch">

                <Grid Margin="0,0,0,10">
                    <TextBlock Text="SSH 隧道" Style="{StaticResource DshSectionHeader}"/>
                    <Border Style="{StaticResource DshPill}" HorizontalAlignment="Right">
                        <TextBlock x:Name="TunnelCountText" Text="0" FontSize="11"
                                   Foreground="{DynamicResource DshTextTertiary}"/>
                    </Border>
                </Grid>

                <Border x:Name="EmptyTunnelsHint" Style="{StaticResource DshCard}" Padding="28">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="↗" Foreground="{DynamicResource DshAccent}" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="添加你的第一个隧道" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource DshTextPrimary}" HorizontalAlignment="Center" Margin="0,12,0,8"/>
                        <TextBlock Text="通过 SSH 安全访问远程网页。添加服务器、用户名和转发端口即可开始。" Style="{StaticResource DshMuted}" TextAlignment="Center"/>
                        <Button Content="＋ 添加隧道" Style="{StaticResource DshPrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="AddTunnel_Click" AutomationProperties.AutomationId="ManagementView.AddTunnel_Click"/>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="TunnelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DshCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding StatusVisibility}"/>
                                            <TextBlock Text="{Binding Name}" FontSize="15" MaxWidth="300" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DshTextPrimary}"
                                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding StatusVisibility}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource DshMono}"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding LocalText}" Style="{StaticResource DshLabel}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource DshRowPrimaryButton}" Content="连接"
                                                Tag="{Binding}" Click="TunnelConnect_Click" AutomationProperties.AutomationId="ManagementView.TunnelConnect_Click"/>
                                        <Button Style="{StaticResource DshRowButton}" Content="停止"
                                                Tag="{Binding}" Click="TunnelStop_Click"
                                                Visibility="{Binding StopVisibility}" AutomationProperties.AutomationId="ManagementView.TunnelStop_Click"/>
                                        <Button Style="{StaticResource DshRowButton}" Content="编辑"
                                                Tag="{Binding}" Click="TunnelEdit_Click" AutomationProperties.AutomationId="ManagementView.TunnelEdit_Click"/>
                                        <Button Style="{StaticResource DshDangerButton}" Content="删除"
                                                Padding="10,5" Tag="{Binding}" Click="TunnelDelete_Click" AutomationProperties.AutomationId="ManagementView.TunnelDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>




                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="直连地址" AutomationProperties.AutomationId="ManagementView.TabItem.2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,22,24,28" AutomationProperties.AutomationId="ManagementView.ScrollViewer.2">
                    <StackPanel MaxWidth="940" HorizontalAlignment="Stretch">

                <TextBlock Text="直连" Style="{StaticResource DshSectionHeader}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <ComboBox x:Name="DirectInput"
                                  Style="{StaticResource DshEditableComboBox}"
                                  ToolTip="输入 IP、机器名或完整 URL；下拉可选择局域网机器"
                                  DropDownOpened="DirectInput_DropDownOpened"
                                  SelectionChanged="DirectInput_SelectionChanged" AutomationProperties.AutomationId="ManagementView.DirectInput"/>
                        <TextBlock Text="输入 IP、机器名或完整 URL…"
                                   IsHitTestVisible="False"
                                   Margin="11,0,0,0" VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource DshTextTertiary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=DirectInput}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" Content="刷新" Padding="12,7"
                            Style="{StaticResource DshButton}" ToolTip="刷新局域网机器"
                            Click="RefreshDirectMachines_Click" AutomationProperties.AutomationId="ManagementView.RefreshDirectMachines_Click"/>
                    <Button Grid.Column="2" Content="添加" Padding="14,7"
                            Style="{StaticResource DshPrimaryButton}"
                            Click="AddDirect_Click" AutomationProperties.AutomationId="ManagementView.AddDirect_Click"/>
                </Grid>
                <TextBlock x:Name="EmptyDirectHint" Style="{StaticResource DshMuted}" Margin="0,0,0,10"
                           Text="也可直接添加 http(s) 地址，不经过 SSH 隧道访问；打开输入框下拉可选择局域网机器。"/>

                <ItemsControl x:Name="DirectList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DshCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Host}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DshTextPrimary}"/>
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource DshMono}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource DshRowButton}" Content="{Binding AuthLabel}"
                                                Tag="{Binding}" Click="DirectAuthToggle_Click"
                                                ToolTip="认证模式：点击切换。「NSSM 自动」用于 dsh web 就跑在本机（NSSM 托管）的直连地址——打开标签时自动读本机 NSSM 日志取最新 token 并自动登录；失败或日志缺失则原样打开，仍可走页面上的粘贴框兜底。" AutomationProperties.AutomationId="ManagementView.DirectAuthToggle_Click"/>
                                        <Button Style="{StaticResource DshRowPrimaryButton}" Content="连接"
                                                Tag="{Binding}" Click="DirectConnect_Click" AutomationProperties.AutomationId="ManagementView.DirectConnect_Click"/>
                                        <Button Style="{StaticResource DshDangerButton}" Content="删除"
                                                Padding="10,5" Tag="{Binding}" Click="DirectDelete_Click" AutomationProperties.AutomationId="ManagementView.DirectDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>




                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="设置与更新" AutomationProperties.AutomationId="ManagementView.TabItem.3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,22,24,28" AutomationProperties.AutomationId="ManagementView.ScrollViewer.3">
                    <StackPanel MaxWidth="940" HorizontalAlignment="Stretch">

                <TextBlock Text="设置" Style="{StaticResource DshSectionHeader}" Margin="0,0,0,10"/>

                <Border Style="{StaticResource DshCard}">
                    <StackPanel>
                        <TextBlock Text="关闭主窗口时" Style="{StaticResource DshLabel}"/>
                        <ComboBox x:Name="CloseBehaviorBox" Width="240" Margin="0,7,0,0"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource DshComboBox}"
                                  SelectionChanged="CloseBehaviorBox_SelectionChanged" AutomationProperties.AutomationId="ManagementView.CloseBehaviorBox"/>
                        <CheckBox x:Name="RestoreLayoutBox" Margin="0,14,0,0"
                                  Style="{StaticResource DshCheckBox}"
                                  Content="启动时自动恢复上次布局"
                                  Checked="RestoreLayoutBox_Changed"
                                  Unchecked="RestoreLayoutBox_Changed" AutomationProperties.AutomationId="ManagementView.RestoreLayoutBox"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DshCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="自动更新" Style="{StaticResource DshSectionHeader}"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource DshMono}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="更新源（各地址都会保留，切换不丢）"
                                   Style="{StaticResource DshLabel}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="UpdateSourceBox" Width="280" HorizontalAlignment="Left"
                                  Style="{StaticResource DshComboBox}"
                                  SelectionChanged="UpdateSourceBox_SelectionChanged" AutomationProperties.AutomationId="ManagementView.UpdateSourceBox">
                            <ComboBoxItem Content="家庭目录（局域网共享）" Tag="home" AutomationProperties.AutomationId="ManagementView.ComboBoxItem.home.1"/>
                            <ComboBoxItem Content="GitHub" Tag="github" AutomationProperties.AutomationId="ManagementView.ComboBoxItem.github.1"/>
                            <ComboBoxItem Content="Gitee（默认）" Tag="gitee" AutomationProperties.AutomationId="ManagementView.ComboBoxItem.gitee.1"/>
                        </ComboBox>

                        <TextBlock Text="地址（家庭目录填 UNC 路径或 http 目录；Gitee / GitHub 填仓库地址）"
                                   Style="{StaticResource DshLabel}" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UpdateServerBox" Style="{StaticResource DshMonoTextBox}" AutomationProperties.AutomationId="ManagementView.UpdateServerBox"/>
                            <Button Grid.Column="1" Content="保存" Padding="12,7"
                                    Style="{StaticResource DshButton}" Click="SaveUpdateServer_Click" AutomationProperties.AutomationId="ManagementView.SaveUpdateServer_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="CheckUpdateButton" Content="检查更新" Padding="14,7" Margin="0"
                                    Style="{StaticResource DshPrimaryButton}" Click="CheckUpdate_Click" AutomationProperties.AutomationId="ManagementView.CheckUpdateButton"/>
                            <Button x:Name="ApplyUpdateButton" Content="下载并重启" Padding="14,7"
                                    Style="{StaticResource DshButton}" Click="ApplyUpdate_Click" AutomationProperties.AutomationId="ManagementView.ApplyUpdateButton"/>
                        </StackPanel>
                        <ProgressBar x:Name="UpdateProgressBar" Margin="0,12,0,0"
                                     Visibility="Collapsed"
                                     Style="{StaticResource DshProgressBar}"/>
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource DshMuted}" Margin="0,10,0,0"/>

                        <TextBlock Text="更新日志" Style="{StaticResource DshLabel}" Margin="0,16,0,6"/>
                        <TextBox x:Name="ChangelogBox" MinHeight="150" MaxHeight="260"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="{DynamicResource DshTextSecondary}"
                                 Style="{StaticResource DshMonoTextBox}" AutomationProperties.AutomationId="ManagementView.ChangelogBox"/>

                        <TextBlock Style="{StaticResource DshLabel}" Margin="0,12,0,0"
                                   Text="支持安装版与便携版自动更新。连接和布局保存在当前用户目录，不会被更新覆盖。"/>
                    </StackPanel>
                </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
