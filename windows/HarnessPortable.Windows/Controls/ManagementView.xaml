<UserControl x:Class="HarnessPortable.Windows.Controls.ManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF"
             FontFamily="Segoe UI, Microsoft YaHei UI">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F9FAFB" Padding="16,12" BorderBrush="#EBEEF2" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="AddTunnelButton" DockPanel.Dock="Right" Content="+ 添加隧道"
                        Style="{StaticResource ModernPrimaryButton}" Padding="14,7"
                        Click="AddTunnel_Click"/>
                <StackPanel>
                    <TextBlock Text="Harness Portable" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="SSH 本地端口转发 + 内嵌浏览器" Style="{StaticResource ModernMutedText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SSH 隧道" Style="{StaticResource ModernGroupHeader}"/>
                    <TextBlock x:Name="TunnelCountText" Grid.Column="1" Text="0"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#9CA3AF" FontSize="12"/>
                </Grid>

                <TextBlock x:Name="EmptyTunnelsHint" Style="{StaticResource ModernMutedText}" Margin="0,0,0,10"
                           Text="还没有隧道。点右上角 + 添加：填服务器 IP / 域名 / NetBIOS 名、SSH 端口、用户名，转发到 127.0.0.1:3080。"/>

                <ItemsControl x:Name="TunnelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium"
                                                       Foreground="#111827" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding StatusVisibility}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource ModernMutedText}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding LocalText}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ModernButton}" Content="连接"
                                                Tag="{Binding}" Click="TunnelConnect_Click"/>
                                        <Button Style="{StaticResource ModernButton}" Content="停止"
                                                Tag="{Binding}" Click="TunnelStop_Click"
                                                Visibility="{Binding StopVisibility}"/>
                                        <Button Style="{StaticResource ModernButton}" Content="编辑"
                                                Tag="{Binding}" Click="TunnelEdit_Click"/>
                                        <Button Style="{StaticResource ModernDangerButton}" Content="删除"
                                                Tag="{Binding}" Click="TunnelDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,12,0,12"/>

                <TextBlock Text="直连" Style="{StaticResource ModernGroupHeader}" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="添加" Padding="14,6" Margin="8,0,0,0"
                            Style="{StaticResource ModernPrimaryButton}"
                            Click="AddDirect_Click"/>
                    <TextBox x:Name="DirectInput" Style="{StaticResource ModernTextBox}"
                             ToolTip="IP 或完整 URL，如 192.168.0.104"/>
                </DockPanel>
                <TextBlock x:Name="EmptyDirectHint" Style="{StaticResource ModernMutedText}" Margin="0,0,0,10"
                           Text="也可直接添加 http(s) 地址，不经过 SSH 隧道访问。"/>
                <ItemsControl x:Name="DirectList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Host}" FontSize="14" FontWeight="Medium" Foreground="#111827"/>
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource ModernMutedText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ModernButton}" Content="连接"
                                                Tag="{Binding}" Click="DirectConnect_Click"/>
                                        <Button Style="{StaticResource ModernDangerButton}" Content="删除"
                                                Tag="{Binding}" Click="DirectDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,12,0,12"/>

                <TextBlock Text="设置" Style="{StaticResource ModernGroupHeader}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource ModernCardBorder}">
                    <StackPanel>
                        <TextBlock Text="关闭主窗口时" FontSize="13" Foreground="#111827"/>
                        <ComboBox x:Name="CloseBehaviorBox" Width="240" Margin="0,8,0,0"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="CloseBehaviorBox_SelectionChanged"/>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource ModernMutedText}"
                                   Text="所有配置保存在 %APPDATA%\HarnessPortable（系统用户目录），不会写入 exe 所在文件夹。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
