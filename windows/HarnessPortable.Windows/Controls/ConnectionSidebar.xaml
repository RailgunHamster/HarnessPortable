<UserControl x:Class="HarnessPortable.Windows.Controls.ConnectionSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HarnessPortable.Windows.Controls"
             Background="{DynamicResource DshBgBase}">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:ConnectionGroup}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource DshTextSecondary}" Margin="2,9,0,6"/>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type local:ConnectionRow}">
            <Grid Margin="0,2" MinWidth="150">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource ModernToolbarButton}" Tag="{Binding}" Click="Open_Click"
                        HorizontalContentAlignment="Left" Padding="8" ToolTip="{Binding Entry.Address}">
                    <StackPanel>
                        <TextBlock Text="{Binding Entry.Name}" TextTrimming="CharacterEllipsis" MaxWidth="170"
                                   Foreground="{DynamicResource DshTextPrimary}"/>
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu Opened="Menu_Opened">
                            <MenuItem Header="编辑连接" Click="Edit_Click"/>
                            <MenuItem x:Name="FavoriteMenu" Header="加入常用" Click="Favorite_Click"/>
                            <MenuItem Header="设置分组…" Click="Group_Click"/>
                            <Separator/>
                            <MenuItem Header="断开连接" Click="Disconnect_Click" Visibility="{Binding DisconnectVisibility}"/>
                            <MenuItem Header="删除连接…" Click="Delete_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Grid.Column="1" Content="⋯" Style="{StaticResource ModernToolbarButton}" Tag="{Binding}"
                        Padding="5,8" Click="More_Click" ToolTip="编辑、常用和分组"/>
            </Grid>
        </DataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource DshTextPrimary}"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12,16,10,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="连接库" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource DshTextPrimary}" Margin="2,0,0,12"/>
        <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"
                 ToolTip="搜索连接名称、服务器或分组" TextChanged="Search_Changed"
                 AutomationProperties.Name="搜索连接"/>
        <TreeView x:Name="ConnectionTree" Grid.Row="2" Background="Transparent" BorderThickness="0"
                  VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="＋ 添加连接" Style="{StaticResource ModernPrimaryButton}" Click="Add_Click" Padding="12,9"/>
            <Button Content="设置" Style="{StaticResource ModernToolbarButton}" Click="Settings_Click" Margin="0,8,0,0" Padding="12,8"/>
        </StackPanel>
    </Grid>
</UserControl>
