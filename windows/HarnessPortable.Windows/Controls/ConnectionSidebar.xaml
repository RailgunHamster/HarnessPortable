<UserControl x:Class="HarnessPortable.Windows.Controls.ConnectionSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource DshBgBase}" PreviewMouseRightButtonUp="Blank_RightClick">
    <UserControl.Resources>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource DshTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource DshFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DshBgLayer2}"/><Setter Property="Foreground" Value="{DynamicResource DshTextPrimary}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DshAccentSoft}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ViewFilter" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource DshTextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="5,6"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource DshFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource DshBgLayer1}"/><Setter Property="Foreground" Value="{DynamicResource DshTextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource DshTextPrimary}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="LibraryGroup" TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton x:Name="GroupToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" FocusVisualStyle="{StaticResource DshFocus}" AutomationProperties.AutomationId="ConnectionSidebar.GroupToggle">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Grid Margin="8,16,8,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Path x:Name="Chevron" Data="M 2,0 L 6,4 L 2,8" Stroke="{DynamicResource DshTextTertiary}" StrokeThickness="1.3" Width="8" Height="8" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DshTextTertiary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding ItemCount}" FontSize="11" Foreground="{DynamicResource DshTextTertiary}" Margin="8,0,0,0"/>
                            </Grid>
                            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="GroupContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="GroupContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DshAccent}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource DshFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="RowSurface" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource DshBgLayer2}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource DshAccentSoft}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12,18,12,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="7,0,0,13">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="连接" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource DshTextPrimary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="＋" FontSize="19" Width="28" Height="28" Padding="0" Style="{StaticResource QuietButton}" Click="Add_Click" ToolTip="添加 SSH 隧道或直连网页" AutomationProperties.Name="添加连接" AutomationProperties.AutomationId="ConnectionSidebar.Add_Click"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" Padding="30,7,8,7" FontSize="12"
                     ToolTip="搜索名称、服务器或分组" TextChanged="Search_Changed" AutomationProperties.Name="搜索连接" AutomationProperties.AutomationId="ConnectionSidebar.SearchBox"/>
            <Path Data="M 6,0 A 6,6 0 1 1 6,12 A 6,6 0 1 1 6,0 M 10,10 L 15,15" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource DshTextTertiary}" StrokeThickness="1.4" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock Text="搜索连接…" Margin="30,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource DshTextTertiary}" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource DshBgLayer2}" CornerRadius="7" Padding="3" Margin="0,0,0,7">
            <UniformGrid Columns="3">
                <RadioButton x:Name="AllFilter" Content="全部" Tag="all" GroupName="LibraryFilter" Style="{StaticResource ViewFilter}" IsChecked="True" Checked="Filter_Changed" AutomationProperties.AutomationId="ConnectionSidebar.AllFilter.all"/>
                <RadioButton x:Name="FavoritesFilter" Content="常用" Tag="favorites" GroupName="LibraryFilter" Style="{StaticResource ViewFilter}" Checked="Filter_Changed" AutomationProperties.AutomationId="ConnectionSidebar.FavoritesFilter.favorites"/>
                <RadioButton x:Name="RecentFilter" Content="最近" Tag="recent" ToolTip="按最近打开时间排列；在全部或常用中拖动排序" GroupName="LibraryFilter" Style="{StaticResource ViewFilter}" Checked="Filter_Changed" AutomationProperties.AutomationId="ConnectionSidebar.RecentFilter.recent"/>
            </UniformGrid>
        </Border>
        <Grid Grid.Row="3">
            <ListBox x:Name="ConnectionList" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                     AllowDrop="True" PreviewMouseLeftButtonDown="Drag_Pressed" PreviewMouseMove="Drag_Moved" PreviewMouseLeftButtonUp="Drag_Released"
                     PreviewDragOver="Connection_DragOver" PreviewDrop="Connection_Drop" DragLeave="Connection_DragLeave"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewKeyDown="Connections_KeyDown" AutomationProperties.Name="连接列表" AutomationProperties.AutomationId="ConnectionSidebar.ConnectionList">
                <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.GroupStyle><GroupStyle>
                    <GroupStyle.Panel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></GroupStyle.Panel>
                    <GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
                        <Expander Style="{StaticResource LibraryGroup}" IsExpanded="True" Loaded="Group_Loaded" Expanded="Group_ExpansionChanged" Collapsed="Group_ExpansionChanged" AutomationProperties.AutomationId="ConnectionSidebar.Expander"><ItemsPresenter/></Expander>
                    </ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle>
                </GroupStyle></ListBox.GroupStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid>
                        <Grid.ContextMenu><ContextMenu Opened="Menu_Opened" AutomationProperties.AutomationId="ConnectionSidebar.ContextMenu.1">
                            <MenuItem Header="编辑连接" Click="Edit_Click" AutomationProperties.AutomationId="ConnectionSidebar.Edit_Click"/>
                            <MenuItem Header="加入常用" Click="Favorite_Click" AutomationProperties.AutomationId="ConnectionSidebar.Favorite_Click"/>
                            <MenuItem Header="设置分组…" Click="Group_Click" AutomationProperties.AutomationId="ConnectionSidebar.Group_Click"/>
                            <Separator/>
                            <MenuItem Header="断开连接" Click="Disconnect_Click" Visibility="{Binding DisconnectVisibility}" AutomationProperties.AutomationId="ConnectionSidebar.Disconnect_Click"/>
                            <MenuItem Header="删除连接…" Click="Delete_Click" AutomationProperties.AutomationId="ConnectionSidebar.Delete_Click"/>
                        </ContextMenu></Grid.ContextMenu>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                        <Button x:Name="OpenConnectionButton" Style="{StaticResource QuietButton}" Tag="{Binding}" Click="Open_Click" Padding="8,10,3,10"
                                HorizontalContentAlignment="Stretch" Background="Transparent" Focusable="False" ToolTip="{Binding Tooltip}" AutomationProperties.AutomationId="ConnectionSidebar.OpenConnectionButton">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Data="{Binding Icon}" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource DshTextSecondary}" StrokeThickness="1.3" StrokeLineJoin="Round" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Entry.Name}" Foreground="{DynamicResource DshTextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="11"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="5" Height="5" Fill="{Binding StatusBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource DshTextTertiary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Grid.Column="1" Content="⋯" Style="{StaticResource QuietButton}" Tag="{Binding}" Padding="0" Margin="0,8,2,8" Click="More_Click" ToolTip="连接菜单" AutomationProperties.Name="连接菜单" AutomationProperties.AutomationId="ConnectionSidebar.More_Click"/>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="10,30,10,0">
                <TextBlock x:Name="EmptyTitle" FontSize="13" Foreground="{DynamicResource DshTextSecondary}" TextWrapping="Wrap"/>
                <TextBlock x:Name="EmptyHint" FontSize="12" Foreground="{DynamicResource DshTextTertiary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="4" BorderBrush="{DynamicResource DshBorderL1}" BorderThickness="0,1,0,0" Padding="3,9,0,0" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="设置" Style="{StaticResource QuietButton}" Padding="8,5" FontSize="12" Click="Settings_Click" AutomationProperties.AutomationId="ConnectionSidebar.Settings_Click"/>
                <TextBlock x:Name="ConnectionCount" FontSize="11" Foreground="{DynamicResource DshTextTertiary}" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
