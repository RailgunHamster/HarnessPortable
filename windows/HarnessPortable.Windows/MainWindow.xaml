<Window x:Class="HarnessPortable.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        Title="Harness Portable"
        Icon="/Assets/HarnessPortable.png"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="ModernDocumentPaneControlStyle" TargetType="{x:Type avalonDock:LayoutDocumentPaneControl}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type avalonDock:LayoutDocumentPaneControl}">
                        <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Panel.ZIndex="1"
                                  Visibility="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type avalonDock:LayoutDocumentPaneControl}}, Path=Model.ShowHeader, Converter={StaticResource BoolToVisibilityConverter}}">
                                <avalonDock:DocumentPaneTabPanel x:Name="HeaderPanel"
                                                                 IsItemsHost="True"
                                                                 KeyboardNavigation.TabIndex="1"/>
                            </Grid>
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#EBEEF2"
                                    BorderThickness="1,0,0,0"
                                    KeyboardNavigation.DirectionalNavigation="Contained"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.TabNavigation="Cycle">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TabItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <ContentPresenter ContentSource="Header"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <avalonDock:LayoutDocumentTabItem Model="{Binding}"
                                                          Style="{DynamicResource ModernDocumentTabItemStyle}"
                                                          PreviewMouseLeftButtonDown="DocumentTab_PreviewMouseLeftButtonDown"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- Present the document's Content directly instead of
                             wrapping it in a LayoutDocumentControl. AvalonDock's
                             FocusElementManager rewrites a document's IsActive
                             (and through it IsSelected and Root.ActiveContent)
                             whenever a Win32 focus event lands inside a HwndHost
                             that has a LayoutDocumentControl ancestor. The
                             WebView2 is exactly such an HwndHost, so the wrapper
                             turned every focus change inside the page into an
                             activation -> ActiveContentChanged -> focus claim ->
                             focus event loop, re-hosting the browser each round
                             (the white flashing). Without the wrapper the focus
                             manager cannot associate the event with a document;
                             the app activates the document itself on click
                             (see MainWindow.ActivateSessionDoc). -->
                        <ContentPresenter Content="{Binding Content}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDocumentTabItemStyle" TargetType="{x:Type avalonDock:LayoutDocumentTabItem}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#61666B"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type avalonDock:LayoutDocumentTabItem}">
                        <avalonDock:DropDownControlArea
                            DropDownContextMenu="{Binding Root.Manager.DocumentContextMenu}"
                            DropDownContextMenuDataContext="{Binding LayoutItem, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#D9DDE3"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="2,3,2,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter
                                        VerticalAlignment="Center"
                                        Content="{Binding Model, RelativeSource={RelativeSource TemplatedParent}}"
                                        ContentTemplate="{Binding DocumentHeaderTemplate, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type avalonDock:DockingManager}, Mode=FindAncestor}}"
                                        ContentTemplateSelector="{Binding DocumentHeaderTemplateSelector, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type avalonDock:DockingManager}, Mode=FindAncestor}}"/>
                                    <Button x:Name="CloseButton"
                                            Grid.Column="1"
                                            Width="16" Height="16"
                                            Margin="5,0,0,0"
                                            Padding="0"
                                            Command="{Binding LayoutItem.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            Focusable="False"
                                            Cursor="Hand"
                                            ToolTip="关闭标签"
                                            Visibility="Collapsed">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                        UseLayoutRounding="True" SnapsToDevicePixels="True">
                                                    <Path x:Name="CloseGlyph" Data="M4,4 L12,12 M12,4 L4,12"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type avalonDock:LayoutDocumentTabItem}}}"
                                                          StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          UseLayoutRounding="True" SnapsToDevicePixels="True"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FDE8E8"/>
                                                        <Setter TargetName="CloseGlyph" Property="Stroke" Value="#EC1313"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </avalonDock:DropDownControlArea>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EBEEF2"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C6CBD3"/>
                                <Setter Property="Foreground" Value="#0F1115"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#F1F3F5"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C6CBD3"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CanClose}" Value="False">
                                <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border x:Name="ChromeBar" DockPanel.Dock="Top" Background="#F9FAFB" Padding="14,8"
                BorderBrush="#EBEEF2" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="布局预设" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="LayoutPresetBox" Width="170"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="Name"
                              SelectionChanged="LayoutPresetBox_SelectionChanged"/>
                    <Button Content="保存当前布局" Style="{StaticResource ModernToolbarButton}"
                            Margin="6,0,0,0" Click="SaveLayout_Click"/>
                    <Button Content="删除" Style="{StaticResource ModernToolbarButton}"
                            Margin="6,0,0,0" Click="DeleteLayout_Click"/>
                    <TextBlock Text="F11 全屏 · 拖动标签到其他窗格分屏 · 右键标签更多操作" Foreground="#9CA3AF"
                               FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Harness Portable" FontSize="16" FontWeight="SemiBold"
                               Foreground="#111827" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar x:Name="ChromeStatus" DockPanel.Dock="Bottom" Background="#F9FAFB" BorderBrush="#EBEEF2" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#374151"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="StopTunnelButton" Content="停止全部隧道"
                        Style="{StaticResource ModernToolbarButton}"
                        Visibility="Collapsed" Click="StopAll_Click"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <avalonDock:DockingManager x:Name="DockManager"
                                       AllowMixedOrientation="True"
                                       Background="#FFFFFF"
                                       DocumentPaneControlStyle="{StaticResource ModernDocumentPaneControlStyle}">
                <avalonDock:DockingManager.Theme>
                    <avalonDock:GenericTheme/>
                </avalonDock:DockingManager.Theme>
                <avalonDock:DockingManager.DocumentHeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" FontSize="12"/>
                    </DataTemplate>
                </avalonDock:DockingManager.DocumentHeaderTemplate>
                <avalonDock:DockingManager.DocumentContextMenu>
                    <ContextMenu Opened="DocumentContextMenu_Opened">
                        <MenuItem Header="复制标签" Click="DuplicateTab_Click"/>
                        <MenuItem Header="重命名" Click="RenameTab_Click"/>
                        <Separator/>
                        <MenuItem Header="向右拆分" Click="SplitRight_Click"/>
                        <MenuItem Header="向左拆分" Click="SplitLeft_Click"/>
                        <MenuItem Header="向上拆分" Click="SplitUp_Click"/>
                        <MenuItem Header="向下拆分" Click="SplitDown_Click"/>
                        <Separator/>
                        <MenuItem x:Name="SwitchToMenu" Header="切换为…"/>
                        <Separator/>
                        <MenuItem Header="关闭标签" Click="CloseTab_Click"/>
                    </ContextMenu>
                </avalonDock:DockingManager.DocumentContextMenu>
            </avalonDock:DockingManager>

            <Canvas x:Name="TabDragOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                    Panel.ZIndex="20">
                <Border x:Name="DragTargetHighlight"
                        Background="#164D6BFE" BorderBrush="#4D6BFE" BorderThickness="2"
                        CornerRadius="10" Visibility="Collapsed"/>
                <Border x:Name="DragHintCard" Background="#F7F9FF" BorderBrush="#C7D2FE"
                        BorderThickness="1" CornerRadius="8" Padding="12,7"
                        HorizontalAlignment="Center" VerticalAlignment="Top">
                    <TextBlock x:Name="DragHintText" Text="拖到目标区域后释放"
                               Foreground="#334155" FontSize="12"/>
                </Border>
                <Border x:Name="DropZoneCard" Width="238" Height="174"
                        Background="#F8FAFF" BorderBrush="#A5B4FC" BorderThickness="1"
                        CornerRadius="12" Padding="10" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DropUpButton" Grid.Row="0" Grid.Column="1" Content="↑ 上"
                                Style="{StaticResource ModernToolbarButton}"/>
                        <Button x:Name="DropLeftButton" Grid.Row="1" Grid.Column="0" Content="← 左"
                                Style="{StaticResource ModernToolbarButton}"/>
                        <Button x:Name="DropCenterButton" Grid.Row="1" Grid.Column="1" Content="⊙ 标签"
                                Style="{StaticResource ModernPrimaryButton}"/>
                        <Button x:Name="DropRightButton" Grid.Row="1" Grid.Column="2" Content="右 →"
                                Style="{StaticResource ModernToolbarButton}"/>
                        <Button x:Name="DropDownButton" Grid.Row="2" Grid.Column="1" Content="↓ 下"
                                Style="{StaticResource ModernToolbarButton}"/>
                    </Grid>
                </Border>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>
