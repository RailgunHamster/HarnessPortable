<Window x:Class="HarnessPortable.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        Title="Harness Portable"
        Icon="/Assets/HarnessPortable.ico"
        Width="1200" Height="780"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F4F6" Padding="12,8"
                BorderBrush="#E3E6EA" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SplitRightButton" Content="当前标签 → 右侧分屏" Padding="10,5"
                            Margin="4,0,0,0" Click="SplitRight_Click"/>
                    <Button x:Name="SplitDownButton" Content="当前标签 ↓ 下方分屏" Padding="10,5"
                            Margin="4,0,0,0" Click="SplitDown_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Harness Portable" FontSize="16" FontWeight="Bold"
                               Foreground="#111827" VerticalAlignment="Center"/>
                    <TextBlock Text="拖动标签到窗口边缘也可分屏" Margin="12,0,0,0"
                               Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F9FAFB">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#374151"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="StopTunnelButton" Content="停止全部隧道" Padding="10,2"
                        Visibility="Collapsed" Click="StopAll_Click"/>
            </StatusBarItem>
        </StatusBar>

        <avalonDock:DockingManager x:Name="DockManager">
            <avalonDock:DockingManager.Theme>
                <avalonDock:GenericTheme/>
            </avalonDock:DockingManager.Theme>
        </avalonDock:DockingManager>
    </DockPanel>
</Window>
