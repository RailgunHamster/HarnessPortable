<Window x:Class="HarnessPortable.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Harness Portable"
        Width="920" Height="680"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E3E6EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="56"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F4F6" Padding="16,12" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="AddTunnelButton" DockPanel.Dock="Right" Content="+ 添加隧道"
                        Padding="14,7" Click="AddTunnel_Click"/>
                <StackPanel>
                    <TextBlock Text="Harness Portable" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="SSH 本地端口转发 + 内嵌浏览器" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#F9FAFB">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#374151"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="StopTunnelButton" Content="断开隧道" Padding="10,2"
                        Visibility="Collapsed" Click="StopTunnel_Click"/>
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SSH 隧道" Style="{StaticResource GroupHeader}"/>
                    <TextBlock x:Name="TunnelCountText" Grid.Column="1" Text="0"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="#9CA3AF" FontSize="12"/>
                </Grid>

                <TextBlock x:Name="EmptyTunnelsHint" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Text="还没有隧道。点右上角 + 添加：填服务器 IP / 域名 / NetBIOS 名、SSH 端口、用户名，转发到 127.0.0.1:3080。"/>

                <ItemsControl x:Name="TunnelList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium"
                                                       Foreground="#111827" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="#059669"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding StatusVisibility}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding LocalText}" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallButton}" Content="连接"
                                                Tag="{Binding}" Click="TunnelConnect_Click"/>
                                        <Button Style="{StaticResource SmallButton}" Content="编辑"
                                                Tag="{Binding}" Click="TunnelEdit_Click"/>
                                        <Button Style="{StaticResource SmallButton}" Content="删除"
                                                Tag="{Binding}" Click="TunnelDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,12,0,12"/>

                <TextBlock Text="直连" Style="{StaticResource GroupHeader}" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="添加" Padding="14,6" Margin="8,0,0,0"
                            Click="AddDirect_Click"/>
                    <TextBox x:Name="DirectInput" Padding="8,6"
                             ToolTip="IP 或完整 URL，如 192.168.0.104"/>
                </DockPanel>
                <TextBlock x:Name="EmptyDirectHint" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Text="也可直接添加 http(s) 地址，不经过 SSH 隧道访问。"/>
                <ItemsControl x:Name="DirectList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Host}" FontSize="14" FontWeight="Medium" Foreground="#111827"/>
                                        <TextBlock Text="{Binding Url}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SmallButton}" Content="连接"
                                                Tag="{Binding}" Click="DirectConnect_Click"/>
                                        <Button Style="{StaticResource SmallButton}" Content="删除"
                                                Tag="{Binding}" Click="DirectDelete_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
