<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DshManagement.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ModernButton" TargetType="Button" BasedOn="{StaticResource DshButton}">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="ModernPrimaryButton" TargetType="Button" BasedOn="{StaticResource DshPrimaryButton}">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="ModernDangerButton" TargetType="Button" BasedOn="{StaticResource DshDangerButton}">
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="ModernToolbarButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource DshTextBox}"/>
    <Style x:Key="ModernEditableComboBox" TargetType="ComboBox" BasedOn="{StaticResource DshEditableComboBox}"/>
    <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource DshComboBox}"/>
    <Style x:Key="ModernCardBorder" TargetType="Border" BasedOn="{StaticResource DshCard}"/>
    <Style x:Key="ModernGroupHeader" TargetType="TextBlock" BasedOn="{StaticResource DshSectionHeader}"/>
    <Style x:Key="ModernMutedText" TargetType="TextBlock" BasedOn="{StaticResource DshMuted}"/>
    <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource DshInputBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource DshTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DshInputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CaretBrush" Value="{DynamicResource DshTextPrimary}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource DshAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DshAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
