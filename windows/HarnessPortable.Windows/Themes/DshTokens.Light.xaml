<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Shared shell palette. Frozen brushes are swapped as a dictionary on appearance changes. -->
    <SolidColorBrush x:Key="DshBgBase" Color="#F3F5F9" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBgLayer1" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBgLayer2" Color="#EDF1F7" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBgLayer3" Color="#E3E9F2" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBorderL1" Color="#DFE5EF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBorderL2" Color="#CFD8E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBorderL3" Color="#B8C6DA" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshTextPrimary" Color="#172239" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshTextSecondary" Color="#526078" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshTextTertiary" Color="#5E6B83" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBrandFill" Color="#365EDC" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBrandFillHover" Color="#2B50C7" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBrandFillPressed" Color="#2343AA" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBrandText" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshAccent" Color="#365EDC" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshAccentSoft" Color="#E9EEFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshAccentWash" Color="#22365EDC" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshGreen" Color="#15805F" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshRed" Color="#C9364B" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshAmber" Color="#97680A" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshDangerText" Color="#C9364B" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshDangerBorder" Color="#E9BAC3" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshDangerFillHover" Color="#FCECEF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshInputBg" Color="#FFFFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshInputBorder" Color="#CFD8E6" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshScrollThumb" Color="#B8C6DA" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshScrim" Color="#8F172239" po:Freeze="True"/>
    <FontFamily x:Key="DshUiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DshMonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <CornerRadius x:Key="DshRadiusCard">16</CornerRadius>
    <CornerRadius x:Key="DshRadiusControl">10</CornerRadius>
</ResourceDictionary>
