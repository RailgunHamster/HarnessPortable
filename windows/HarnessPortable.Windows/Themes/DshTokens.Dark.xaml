<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Shared shell palette. Frozen brushes are swapped as a dictionary on appearance changes. -->
    <SolidColorBrush x:Key="DshBgBase" Color="#101722" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBgLayer1" Color="#182231" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBgLayer2" Color="#202D40" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBgLayer3" Color="#2B3A50" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBorderL1" Color="#2B3A50" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBorderL2" Color="#35455D" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBorderL3" Color="#536783" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshTextPrimary" Color="#EDF2FB" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshTextSecondary" Color="#A7B5CC" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshTextTertiary" Color="#92A1BA" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBrandFill" Color="#8EAFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBrandFillHover" Color="#ABC3FF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBrandFillPressed" Color="#759AEE" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshBrandText" Color="#101722" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshAccent" Color="#8EAFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshAccentSoft" Color="#263858" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshAccentWash" Color="#328EAFFF" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshGreen" Color="#4BD2A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshRed" Color="#FF8C9E" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshAmber" Color="#F2C66D" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshDangerText" Color="#FF8C9E" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshDangerBorder" Color="#76414D" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshDangerFillHover" Color="#402734" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshInputBg" Color="#182231" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshInputBorder" Color="#35455D" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshScrollThumb" Color="#536783" po:Freeze="True"/>
    <SolidColorBrush x:Key="DshScrim" Color="#B3000000" po:Freeze="True"/>
    <FontFamily x:Key="DshUiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DshMonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <CornerRadius x:Key="DshRadiusCard">16</CornerRadius>
    <CornerRadius x:Key="DshRadiusControl">10</CornerRadius>
</ResourceDictionary>
