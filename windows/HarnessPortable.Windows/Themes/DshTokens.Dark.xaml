<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark alias layer, values taken from DSH's own design system
         (dsh-client-ui-theme: bg-base 950 #151517, layers 875/850/800,
         border levels #ffffff0f/1f/29, brand-primary #f9fafb, accent #5686fe).
         Same keys as DshTokens.Light.xaml. -->
    <SolidColorBrush x:Key="DshBgBase" Color="#151517"/>
    <SolidColorBrush x:Key="DshBgLayer1" Color="#232324"/>
    <SolidColorBrush x:Key="DshBgLayer2" Color="#2C2C2E"/>
    <SolidColorBrush x:Key="DshBgLayer3" Color="#353638"/>

    <SolidColorBrush x:Key="DshBorderL1" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="DshBorderL2" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="DshBorderL3" Color="#29FFFFFF"/>

    <SolidColorBrush x:Key="DshTextPrimary" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="DshTextSecondary" Color="#CFD3D6"/>
    <SolidColorBrush x:Key="DshTextTertiary" Color="#ADB2B8"/>

    <SolidColorBrush x:Key="DshBrandFill" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="DshBrandFillHover" Color="#E1E5EE"/>
    <SolidColorBrush x:Key="DshBrandFillPressed" Color="#CFD3D6"/>
    <SolidColorBrush x:Key="DshBrandText" Color="#0F1115"/>

    <SolidColorBrush x:Key="DshAccent" Color="#5686FE"/>
    <SolidColorBrush x:Key="DshAccentSoft" Color="#245686FE"/>

    <SolidColorBrush x:Key="DshGreen" Color="#22C55E"/>
    <SolidColorBrush x:Key="DshRed" Color="#F25A5A"/>
    <SolidColorBrush x:Key="DshAmber" Color="#F7AD31"/>

    <SolidColorBrush x:Key="DshDangerText" Color="#F25A5A"/>
    <SolidColorBrush x:Key="DshDangerBorder" Color="#59EF4444"/>
    <SolidColorBrush x:Key="DshDangerFillHover" Color="#33EF4444"/>

    <SolidColorBrush x:Key="DshInputBg" Color="#232324"/>
    <SolidColorBrush x:Key="DshInputBorder" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="DshScrollThumb" Color="#545557"/>

    <FontFamily x:Key="DshUiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="DshMonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <CornerRadius x:Key="DshRadiusCard">12</CornerRadius>
    <CornerRadius x:Key="DshRadiusControl">8</CornerRadius>
</ResourceDictionary>
