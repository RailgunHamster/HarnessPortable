<Window x:Class="HarnessPortable.Windows.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 密码" Icon="/Assets/HarnessPortable.png" Height="260" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F9FAFB"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ProfileSummary" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                   Text="密码将使用 Windows DPAPI 加密后存储在本机，仅用于建立隧道。"/>
        <PasswordBox x:Name="PasswordInput" Grid.Row="2" Style="{StaticResource ModernPasswordBox}"
                     Margin="0,12,0,0" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" Style="{StaticResource ModernButton}" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="保存并连接" Width="104"
                    Style="{StaticResource ModernPrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
