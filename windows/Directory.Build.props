<Project>
  <PropertyGroup>
    <RepoVersionFile>$(MSBuildThisFileDirectory)..\VERSION</RepoVersionFile>
    <Version Condition="Exists('$(RepoVersionFile)')">$([System.IO.File]::ReadAllText('$(RepoVersionFile)').Trim())</Version>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>
</Project>
